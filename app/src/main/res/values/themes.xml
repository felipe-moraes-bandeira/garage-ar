<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GarageAR" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/papaya</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">#3A2200</item>
        <item name="colorOnPrimaryContainer">@color/papaya_light</item>
        <item name="colorSecondary">@color/papaya_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">#3A2200</item>
        <item name="colorOnSecondaryContainer">@color/papaya</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">#3A3A3A</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="Widget.Garage.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#262626</item>
    </style>

    <style name="Text.Garage.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Garage.Subtitle" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
